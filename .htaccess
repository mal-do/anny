# annymaldonado.com

ErrorDocument 404 /404.html

# ---------- Redirecciones ----------
# Duplicados unificados el 2026-08-22: el mismo artículo estaba publicado dos veces.
Redirect 301 /amar-es-crecer-2/ /amar-es-crecer/
Redirect 301 /no-tienes-nada-que-perder-2/ /no-tienes-nada-que-perder/

# Los archivos de WordPress (categoría, etiqueta, autor, tipo) listaban las mismas
# entradas cuatro veces. Se sustituyeron por un único blog agrupado por temas.
RedirectMatch 301 ^/category/.*$   /blog/
RedirectMatch 301 ^/tag/.*$        /blog/
RedirectMatch 301 ^/author/.*$     /blog/
RedirectMatch 301 ^/type/.*$       /blog/
RedirectMatch 301 ^/blog/page/.*$  /blog/

# Los servicios pasaron de secciones de una sola página a páginas propias.
Redirect 301 /servicios/terapia-individual  /servicios/terapia-individual/
RedirectMatch 301 ^/feed/?$          /blog/
RedirectMatch 301 ^/comments/feed/?$ /blog/

# Los archivos salieron de wp-content a rutas limpias; puede haber imágenes
# enlazadas desde fuera (Facebook, etc.).
RedirectMatch 301 ^/wp-content/uploads/.*/([^/]+)$ /img/$1
RedirectMatch 410 ^/wp-includes/.*$
RedirectMatch 410 ^/wp-admin/.*$
RedirectMatch 410 ^/xmlrpc\.php$

# ---------- Rendimiento ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
  ExpiresByType text/html              "access plus 1 hour"
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.(css|js|jpg|jpeg|png|webp|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

Options -Indexes
